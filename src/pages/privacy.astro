---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site.js';
---

<BaseLayout title={`Privacy | ${site.name}`} description={`Privacy information for ${site.name}.`}>
  <section class="privacy-page" id="top">
    <p class="eyebrow">Your information</p>
    <h1>Privacy</h1>
    {!site.privacy.reviewed && <p class="privacy-page__draft">This is sample privacy text. Review and replace it before publishing the website.</p>}
    <dl>
      <div><dt>Responsible for this site</dt><dd>{site.privacy.controller}</dd></div>
      <div><dt>Privacy contact</dt><dd>{site.privacy.contactEmail}</dd></div>
    </dl>
    {site.privacy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <a class="text-link" href="/">Return home <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
